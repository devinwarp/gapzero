# GapZero configuration. Copy to .env and fill in locally. NEVER commit .env.

# --- Run mode -------------------------------------------------------------
# true  = DuckDB over the generated CSVs instead of Zetaris (no Zetaris needed)
SAMPLE_MODE=true
LOG_LEVEL=info
PORT=8000

# --- Meterless Runtime (Nightshift) : primary AI provider -----------------
# Copy both values from Nightshift > Console. Leave the token empty to use the
# offline no-model fallback in sample mode.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_APP_ID=gapzero
# Routing ids from GET /v1/models. Pin Nemotron-backed lanes for the NVIDIA award.
METERLESS_MODEL_FAST=meterless/fast
METERLESS_MODEL_DEEP=meterless/deep
# NOTE: the NVIDIA API key does NOT go here. It lives in Nightshift > Providers.

# --- Zetaris (live mode) --------------------------------------------------
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=
ZETARIS_QUERY_TIMEOUT_SECONDS=20

# --- Source systems (docker compose; local-only demo credentials) --------
BILLING_PG_PASSWORD=change-me-locally
CRM_MYSQL_PASSWORD=change-me-locally
LEDGER_API_PORT=8070

# --- Agent loop bounds ----------------------------------------------------
GAP_TOLERANCE_USD=1
MAX_ITERATIONS=12
RUN_TIME_BUDGET_SECONDS=480
SIM_SEED=42
